# --- Browser ---------------------------------------------------------------
# Vite inlines every VITE_-prefixed variable into the JavaScript bundle, so
# anything here is public by definition. The publishable key is designed for
# that: on its own it can only do what RLS policies allow an anonymous or
# signed-in visitor to do.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Local scripts only ----------------------------------------------------
# Used by scripts/create-students.ts, which is run by hand and never deployed:
#   node --env-file=.env scripts/create-students.ts 30
#
# NEVER add a VITE_ prefix to these. The service-role key bypasses row-level
# security completely — with it, any visitor could read and rewrite every
# student's data. It must stay out of the bundle and out of git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
